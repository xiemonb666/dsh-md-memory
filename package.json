{
  "name": "dsh-md-memory",
  "version": "0.1.17",
  "description": "Markdown Memory Ledger for DeepSeek Harness: file-based project memory (.dsh-memory/*.md) with integrity-checked Guardian sync every N turns and before every compaction, memory_search/memory_read tools, and the 项目记忆/上下文 tabs in the Web UI. exports: . = root bundle entry (lib/root.js, inert; makes the dsh.client half visible to the host boot-manifest scan), ./engine = per-session compaction engine (lib/index.js), ./client = browser module (lib/client.js).",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "memory",
    "ledger",
    "compaction",
    "markdown"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "lib/root.js",
  "scripts": {
    "test": "node --test \"test/**/*.test.js\""
  },
  "exports": {
    ".": "./lib/root.js",
    "./engine": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-agent-presets": ">=0.1.0",
    "@deepseek-ai/dsh-compaction": ">=0.1.0",
    "@deepseek-ai/dsh-compaction-basic": ">=0.1.0",
    "@deepseek-ai/dsh-llm": ">=0.1.0",
    "@deepseek-ai/dsh-session": ">=0.1.0",
    "@deepseek-ai/dsh-session-query": ">=0.1.0",
    "@deepseek-ai/dsh-tools": ">=0.1.0",
    "@deepseek-ai/schemastery": ">=3.0.0"
  }
}
